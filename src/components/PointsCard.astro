---
// A card with a title, a paragraph, and an optional bullet list.
// Shared by the Programs and Locations sections on the About page.
interface Props {
  title: string;
  description: string;
  points?: string[];
}
const { title, description, points = [] } = Astro.props;
---

<article class="card">
  <h3>{title}</h3>
  <p>{description}</p>
  {
    points.length > 0 && (
      <ul>
        {points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }
</article>

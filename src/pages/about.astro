---
import BaseLayout from "../layouts/BaseLayout.astro";
import PointsCard from "../components/PointsCard.astro";
import { getCollection } from "astro:content";

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const programs = (await getCollection("programs")).sort(byOrder);
const locations = (await getCollection("locations")).sort(byOrder);
const partners = (await getCollection("partners")).sort(byOrder);
const gallery = (await getCollection("gallery")).sort(byOrder);
---

<BaseLayout
  title="Feeding the Flock SD | About"
  description="Learn more about Feeding the Flock SD, our programs, locations, and community gallery."
  page="about"
  ogImage="/images/photos/IMG_2244.JPG"
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">About Feeding the Flock SD</span>
        <h1>Serving our community by providing when they need us most.</h1>
        <p class="lead">
          Feeding the Flock SD helps care for neighbors through organized
          drive-through food distributions, senior pantry support, emergency food
          assistance, school partnerships, and compassionate outreach.
        </p>
        <div class="hero-actions">
          <a href="#programs" class="btn btn-secondary">View Programs</a>
          <a href="#gallery" class="btn btn-primary">View Gallery</a>
        </div>
      </div>

      <div class="hero-panel">
        <img
          src="/images/photos/IMG_2244.JPG"
          alt="Feeding the Flock SD serving neighbors in the community"
        />
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <span class="eyebrow">Our Story</span>

        <h2>Born from a simple calling to feed people and care well for them.</h2>

        <p>
          Our organization and volunteers have been providing for the community
          as an unofficial group for over 15 years. We made it official and
          founded Feeding the Flock SD in 2016 with a simple mission: to feed the
          hungry, honor the dignity of every person served, and show up for
          neighbors in times of need. Today, that mission takes shape through
          organized food distributions, senior support, emergency assistance,
          school partnerships, and volunteer service.
        </p>
        <p>
          Our work is shaped by compassion and a faith-based desire to serve.
          Volunteers help receive food from the San Diego Food Bank, sort it into
          food boxes with items like proteins, vegetables, fruit, and canned
          goods, and serve those boxes through a welcoming drive-through pickup.
        </p>
      </div>

      <div class="card">
        <h3>Our Mission</h3>
        <p>
          Feeding the Flock SD exists to relieve hunger, restore dignity, and
          care for people through organized food distributions, pantry support,
          emergency assistance, school partnerships, and compassionate outreach.
        </p>
        <ul>
          <li>Serve people with dignity, compassion, and respect</li>
          <li>Provide practical food support where it is needed most</li>
          <li>Strengthen community through compassion, service, and care</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="programs">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Programs</span>
        <h2>Programs built around practical help and compassionate service.</h2>
        <p>
          Feeding the Flock SD serves through practical, volunteer-led efforts
          that help food reach people in a way that is organized, accessible, and
          respectful.
        </p>
      </div>

      <div class="grid grid-2">
        {
          programs.map((program) => (
            <PointsCard
              title={program.data.title}
              description={program.data.description}
              points={program.data.points}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band" id="locations">
    <div class="container">
      <div class="section-header center">
        <h1>Locations</h1>
        <h3>
          Feeding the Flock SD serves through distribution days, pantry support,
          school partnerships, and community outreach.
        </h3>
      </div>

      <div class="grid grid-2">
        {
          locations.map((location) => (
            <PointsCard
              title={location.data.title}
              description={location.data.description}
              points={location.data.points}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="partners">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Partners</span>
        <h2>Community partners help make this work possible.</h2>
        <p>
          Our work comes from the generosity and hearts of many. Feeding the
          Flock SD is grateful to work closely with many local organizations and
          service partners. Some have invited us in, some have grown alongside us;
          together they help make it possible for food and care to reach more
          homes, more families than ever.
        </p>
      </div>

      <div
        class="partner-logo-grid"
        aria-label="Feeding the Flock SD partner logos"
      >
        {partners.map((partner) => <img src={partner.data.logo} alt={partner.data.name} />)}
      </div>
    </div>
  </section>

  <section class="section" id="gallery">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Gallery</span>
        <h2>Moments from the work and the community behind it.</h2>
        <p>
          These photos reflect the heart of Feeding the Flock SD: sorting and
          packing food boxes, distribution days, pantry support, school
          partnerships, outreach, and the people who make this work possible.
        </p>
      </div>

      <div class="gallery-grid">
        {gallery.map((photo) => <img src={photo.data.src} alt={photo.data.alt} />)}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div class="section-header">
        <span class="eyebrow">Get Involved</span>
        <h2>Help make this work possible.</h2>
        <p>
          Whether you want to give, volunteer, partner with us, or simply learn
          more, your support helps Feeding the Flock SD continue serving people
          with consistency and care.
        </p>
        <div class="hero-actions">
          <a href="/donate.html" class="btn btn-primary">Donate</a>
          <a href="/contact.html" class="btn btn-secondary">Contact Us</a>
        </div>
      </div>

      <div class="card">
        <h3>Every act of support matters.</h3>
        <p>
          Donations, volunteer time, community partnerships, and thoughtful
          support all play a role in helping us feed people, strengthen families,
          and serve with dignity.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

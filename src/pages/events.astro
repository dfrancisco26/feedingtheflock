---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getCollection } from "astro:content";

// Raw event definitions handed to the client-side calendar renderer.
const events = (await getCollection("events")).map((entry) => entry.data);
const calendarData = { events, foodBoxFormUrl: site.foodBoxFormUrl };
---

<BaseLayout
  title="Feeding the Flock SD | Food Help & Events"
  description="Find food assistance, drive-through box signups, and upcoming Feeding the Flock SD events."
  page="events"
>
  <section class="hero help-hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Food Help & Events</span>
        <h1>Find upcoming food distributions and community outreach days.</h1>
        <p class="lead">
          If you or someone you care for needs food support, start here for
          drive-through box signups, pantry days, outreach meals, and upcoming
          distribution dates.
        </p>
        <div class="hero-actions">
          <a href="#" class="btn btn-primary" data-food-box-form-link
            >Request a Food Box</a
          >
          <a href="#calendar" class="btn btn-secondary">View Calendar</a>
        </div>
      </div>

      <div class="help-panel">
        <h2>Need Food Assistance?</h2>
        <p>
          Use the drive-through box request form so our team has the information
          needed to prepare and coordinate food support.
        </p>
        <a href="#" class="btn btn-primary" data-food-box-form-link
          >Open Request Form</a
        >
        <p class="small muted">
          Please complete the form to request a pickup spot for the next
          available distribution day.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="upcoming-events-title">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Coming Up</span>
        <h2 id="upcoming-events-title">Next scheduled events.</h2>
        <p>A quick view of the next distribution and community event dates.</p>
      </div>

      <div class="upcoming-events" data-upcoming-events></div>
    </div>
  </section>

  <section class="section band" id="calendar" aria-labelledby="calendar-title">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Calendar</span>
        <h2 id="calendar-title">Food assistance and outreach calendar.</h2>
        <p>
          Browse weekly pantry and outreach times along with scheduled community
          distribution dates.
        </p>
      </div>

      <div class="events-calendar" data-events-calendar></div>
    </div>
  </section>

  <script
    type="application/json"
    data-calendar-data
    is:inline
    set:html={JSON.stringify(calendarData)}
  />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
---

<BaseLayout
  title="Feeding the Flock SD | Contact"
  description="Contact Feeding the Flock SD for questions, volunteer opportunities, and community support information."
  page="contact"
  ogImage="/images/photos/IMG_2249.JPG"
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Contact Feeding the Flock SD</span>
        <h1>Follow the story of Feeding the Flock SD.</h1>
        <p class="lead">
          See the people, partnerships, distributions, and everyday moments that
          make this work possible.
        </p>

        <div
          class="contact-social-links"
          aria-label="Feeding the Flock SD social media links"
        >
          <a
            href={site.social.facebook}
            aria-label="Feeding the Flock SD on Facebook"
          >
            <img src="/images/fb.png" alt="" class="social-logo-img" />
            <span>Facebook</span>
          </a>
          <a
            href={site.social.instagram}
            aria-label="Feeding the Flock SD on Instagram"
          >
            <img
              src="/images/Instagram_Glyph_Gradient.png"
              alt=""
              class="social-logo-img"
            />
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <div class="hero-panel">
        <img
          src="/images/photos/IMG_2249.JPG"
          alt="Feeding the Flock SD team and community at a local event"
        />
      </div>
    </div>
  </section>

  <section class="section section-tight contact-start-section">
    <div class="container contact-start">
      <div class="contact-info-photo">
        <img
          src="/images/photos/IMG_2283.JPG"
          alt="Feeding the Flock SD volunteers and community members"
        />
      </div>

      <div class="contact-start-copy">
        <span class="eyebrow">Start Here</span>
        <h2>We would love to hear from you.</h2>
        <p>
          Email Feeding the Flock SD for volunteer interest, distribution
          questions, senior pantry support, partnerships, donation help, or
          general questions.
        </p>

        <div
          class="contact-primary-list"
          aria-label="Feeding the Flock SD leadership and mailing contact information"
        >
          <p class="contact-organization">
            <strong>{site.name}</strong><br />
            <a href={`mailto:${site.email}`} class="email-link">{site.email}</a
            ><br />{site.address.line1}<br />{site.address.city}, {
              site.address.state
            } {site.address.zip}
          </p>
          {
            site.contacts.map((contact) => (
              <p>
                <strong>{contact.name}</strong>
                <br />
                {contact.role}
                <br />
                <a href={`mailto:${contact.email}`} class="email-link">
                  {contact.email}
                </a>
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
